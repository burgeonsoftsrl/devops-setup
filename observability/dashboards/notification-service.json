{
  "uid": "devops-setup-notification-service",
  "title": "devops-setup / notification-service",
  "description": "Notifications (MongoDB) <- OrderCreated, PaymentProcessed",
  "tags": [
    "devops-setup",
    "notification-service"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "refresh": 1,
        "current": {}
      }
    ]
  },
  "links": [
    {
      "title": "Other services",
      "type": "dashboards",
      "tags": [
        "devops-setup"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Business",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Notifications stored / min by type",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(notifications_stored_total{job=\"notification-service\"}[$__rate_interval])) * 60",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "id": 2
    },
    {
      "type": "row",
      "title": "Kafka",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Events consumed / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic, outcome) (rate(events_consumed_seconds_count{job=\"notification-service\"}[$__rate_interval]))",
          "legendFormat": "{{topic}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Consume processing time",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(events_consumed_seconds_sum{job=\"notification-service\"}[$__rate_interval])) / sum by (topic) (rate(events_consumed_seconds_count{job=\"notification-service\"}[$__rate_interval]))",
          "legendFormat": "{{topic}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Produce -> consume lag",
      "description": "Includes time a sleeping free-tier instance needed to wake up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(events_consume_lag_seconds_sum{job=\"notification-service\"}[$__rate_interval])) / sum by (topic) (rate(events_consume_lag_seconds_count{job=\"notification-service\"}[$__rate_interval]))",
          "legendFormat": "{{topic}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "id": 6
