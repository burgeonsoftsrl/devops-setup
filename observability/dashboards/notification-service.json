        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{resource.service.name=\"notification-service\"}",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          }
        }
      ],
      "gridPos": {
        "x": 0,
