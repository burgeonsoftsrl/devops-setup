      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Heap",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
