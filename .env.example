# Production environment variables (set these in the Render dashboard / API, never in git).

# --- Kafka: every service that produces/consumes (order, payment, notification) ---
KAFKA_BOOTSTRAP_SERVERS=<host>:<port>
KAFKA_USERNAME=avnadmin               # setting this switches the client to SASL_SSL
KAFKA_PASSWORD=change-me
KAFKA_SASL_MECHANISM=SCRAM-SHA-256    # or SCRAM-SHA-512 / PLAIN (Confluent)
# PEM of the provider CA; needed for Aiven (project CA), omit for public-CA providers.
# Literal "\n" sequences are accepted in place of newlines.
KAFKA_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# --- user-service (Neon Postgres, schema "public") ---
DB_URL=jdbc:postgresql://ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me
# DB_POOL_SIZE=5
# JPA_DDL_AUTO=update

# --- payment-service (same Neon DB, own schema) ---
# DB_URL / DB_USERNAME / DB_PASSWORD as above
# PAYMENTS_SCHEMA=payments
# PAYMENT_APPROVAL_LIMIT=1000         # orders above this total are DECLINED (demo rule)

# --- order-service (MongoDB Atlas, database "orders") ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orders?retryWrites=true&w=majority&appName=devops-setup

# --- notification-service (same Atlas cluster, database "notifications") ---
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notifications?retryWrites=true&w=majority&appName=devops-setup

# --- api-gateway ---
USER_SERVICE_URL=https://user-service-xxxx.onrender.com
ORDER_SERVICE_URL=https://order-service-xxxx.onrender.com
PAYMENT_SERVICE_URL=https://payment-service-xxxx.onrender.com
NOTIFICATION_SERVICE_URL=https://notification-service-xxxx.onrender.com
CORS_ALLOWED_ORIGINS=https://devops-setup.pages.dev,https://*.devops-setup.pages.dev,http://localhost:4200

# PORT is injected by Render automatically.
