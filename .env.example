# Production environment variables (set these in the Render dashboard, not in git).

# --- user-service (Neon Postgres) ---
DB_URL=jdbc:postgresql://ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me
# DB_POOL_SIZE=5
# JPA_DDL_AUTO=update

# --- order-service (Upstash Redis, TLS => rediss://) ---
REDIS_URL=rediss://default:change-me@xxxx.upstash.io:6379

# --- api-gateway ---
USER_SERVICE_URL=https://user-service-xxxx.onrender.com
ORDER_SERVICE_URL=https://order-service-xxxx.onrender.com
CORS_ALLOWED_ORIGINS=https://devops-setup.pages.dev,http://localhost:4200

# PORT is injected by Render automatically.
